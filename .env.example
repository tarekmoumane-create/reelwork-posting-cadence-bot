# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server ID(s), comma-separated. If set, slash commands register instantly to those servers.
# If left blank, commands register globally (can take a few minutes to show up).
GUILD_ID=

# Optional: where to store data (defaults to ./data)
# DATA_DIR=./data

# ScrapeCreators key (https://scrapecreators.com). With this set, TikTok and Instagram
# posts are detected automatically. Without it, those need the link dropped in the channel.
SCRAPECREATORS_API_KEY=

# When to run the daily platform check (24h clock) and in which time zone.
# Each check costs 1 ScrapeCreators credit per TikTok/Instagram profile.
CHECK_TIME=21:00
TIMEZONE=America/New_York
